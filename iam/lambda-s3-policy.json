{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRawTransactions",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {"StringLike": {"s3:prefix": ["raw/*"]}}
    },
    {
      "Sid": "ReadRawTransactions",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/raw/*"
    },
    {
      "Sid": "WriteValidatedAndQuarantinedTransactions",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/processed/*",
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/quarantine/*"
      ]
    }
  ]
}

